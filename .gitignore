# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/

# Environment variables — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
build/

# Rust / Tauri build artifacts
src-tauri/target/
src-tauri/gen/
# Machine-specific Cargo config (MSVC lib paths — not portable across machines)
src-tauri/.cargo/

# OS
.DS_Store
Thumbs.db

# SQLite DBs — the real DB lives in %APPDATA%\rushcut, never in the repo.
# Guards against stray DB files written with a corrupted path-as-filename.
*.db
*.db-shm
*.db-wal
*.sqlite

# Editor
.vscode/
.idea/
*.swp

# AWS / Serverless
.serverless/
cdk.out/

# Test failure screenshots
e2e/screenshots/

# Isolated QA E2E runtime lockfile (#170) -- records the QA-spawned PIDs, never committed
e2e/.qa-lock.json

# Logs
*.log
npm-debug.log*

# Test uploads / local video files — never commit raw footage
src/test-clips/
*.mp4
*.mov
*.MP4
*.MOV

# Spike working files
spike/tmp/
spike/output*

# Claude Code dev tooling — not part of the product; settings.local.json must never be public.
# Everything under .claude/ (kit skills, agents, hooks, settings, rules, the strategy file) is local-only.
# One exception (2026-11-11, #226, explicit owner decision): the regression test
# .claude/hooks/test-kit-hooks.js, which protects the local-only kit invariant hooks.
# The 8 governance-hook files tracked from 2026-07-24 were retired with the kit cutover (#225).
# Git will not apply a nested `!` negation under an excluded parent directory unless traversal is
# explicitly reopened first — hence the `dir/` then `dir/*` pair below, not a single pattern.
.claude/*
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/test-kit-hooks.js

# Local-only project contract (#222): board IDs, project config, tier text. Same practice as the
# sibling kit project. CLAUDE.md imports it and says so if it is missing (fresh clone, worktree).
/AGENTS.md

# Next.js build info
tsconfig.tsbuildinfo
__pycache__/
*.pyc
.venv/
venv/

.vercel
