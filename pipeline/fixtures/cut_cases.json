{
  "_comment": "#284 shared transition-length table. Held by pipeline/_test_cuts.py (resolve_cuts) and src/utils/filmDuration.selftest.ts (resolveCuts). elements: seconds in film order, null = card whose length derives from its cuts. Expected cut: \"full\" = 1.5 s, an integer = that many output frames, 0 = hard cut / no fade.",
  "cases": [
    { "name": "reported shape: card, 2.302 s clip, long clips", "fps": "30000/1001", "between": true, "open": false, "close": false,
      "elements": [null, 2.302, 6, 6, 6], "expect": { "open": 0, "between": [17, 17, "full", "full"], "close": 0 } },
    { "name": "every clip 4.5 s or longer: all full", "fps": "30000/1001", "between": true, "open": true, "close": true,
      "elements": [null, 4.5, 6, 4.5], "expect": { "open": "full", "between": ["full", "full", "full"], "close": "full" } },
    { "name": "4 s clip mid film", "fps": "30000/1001", "between": true, "open": false, "close": false,
      "elements": [6, 4.0, 6], "expect": { "open": 0, "between": [37, 37], "close": 0 } },
    { "name": "3 s clip mid film", "fps": "30000/1001", "between": true, "open": false, "close": false,
      "elements": [6, 3.0, 6], "expect": { "open": 0, "between": [22, 22], "close": 0 } },
    { "name": "1 s clip: quick fades", "fps": "30000/1001", "between": true, "open": false, "close": false,
      "elements": [6, 1.0, 6], "expect": { "open": 0, "between": [7, 7], "close": 0 } },
    { "name": "0.8 s clip: exactly the 6 frame floor", "fps": "30000/1001", "between": true, "open": false, "close": false,
      "elements": [6, 0.8, 6], "expect": { "open": 0, "between": [6, 6], "close": 0 } },
    { "name": "0.7 s clip: hard cuts", "fps": "30000/1001", "between": true, "open": false, "close": false,
      "elements": [6, 0.7, 6], "expect": { "open": 0, "between": [0, 0], "close": 0 } },
    { "name": "few-frame clip", "fps": "30000/1001", "between": true, "open": false, "close": false,
      "elements": [6, 0.1, 6], "expect": { "open": 0, "between": [0, 0], "close": 0 } },
    { "name": "short first clip, one fading side", "fps": "30000/1001", "between": true, "open": false, "close": false,
      "elements": [2.0, 6, 6], "expect": { "open": 0, "between": [30, "full"], "close": 0 } },
    { "name": "short last clip, one fading side", "fps": "30000/1001", "between": true, "open": false, "close": false,
      "elements": [6, 6, 2.0], "expect": { "open": 0, "between": ["full", 30], "close": 0 } },
    { "name": "2.3 s first and last with open and close", "fps": "30000/1001", "between": true, "open": true, "close": true,
      "elements": [2.302, 6, 2.302], "expect": { "open": 17, "between": [17, 17], "close": 17 } },
    { "name": "1 s first and last with open and close", "fps": "30000/1001", "between": true, "open": true, "close": true,
      "elements": [1.0, 6, 1.0], "expect": { "open": 7, "between": [7, 7], "close": 7 } },
    { "name": "two short clips side by side", "fps": "30000/1001", "between": true, "open": false, "close": false,
      "elements": [6, 2.302, 1.0, 6], "expect": { "open": 0, "between": [17, 7, 7], "close": 0 } },
    { "name": "no between transition, open and close only", "fps": "30000/1001", "between": false, "open": true, "close": true,
      "elements": [2.0, 6, 3.0], "expect": { "open": 30, "between": [0, 0], "close": "full" } },
    { "name": "adjacent cards", "fps": "30000/1001", "between": true, "open": false, "close": false,
      "elements": [null, null, 6], "expect": { "open": 0, "between": ["full", "full"], "close": 0 } },
    { "name": "single element with open and close", "fps": "30000/1001", "between": true, "open": true, "close": true,
      "elements": [2.0], "expect": { "open": 15, "between": [], "close": 15 } },
    { "name": "very short first clip, one side, at the floor", "fps": "30000/1001", "between": true, "open": false, "close": false,
      "elements": [0.4, 6], "expect": { "open": 0, "between": [6], "close": 0 } },
    { "name": "60 fps output", "fps": "60", "between": true, "open": false, "close": false,
      "elements": [6, 2.302, 6], "expect": { "open": 0, "between": [34, 34], "close": 0 } },
    { "name": "25 fps output, exactly 4.5 s stays full", "fps": "25", "between": true, "open": false, "close": false,
      "elements": [6, 4.5, 6], "expect": { "open": 0, "between": ["full", "full"], "close": 0 } }
  ]
}
